# Copiar a .env y ajustar. El arranque local funciona sin .env (hay valores por defecto).
SECRET_KEY=cambiar-en-produccion
DEBUG=True
DEFAULT_FROM_EMAIL=noreply@teampulse.local
# Producción: DEBUG=False y lista de hosts separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1
# En Render no hace falta: se completa con RENDER_EXTERNAL_HOSTNAME.
# CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com
# Origen de la SPA para el enlace de recuperar clave y CORS.
FRONTEND_ORIGIN=http://localhost:4200
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Docker Compose: servicio PostgreSQL independiente.
POSTGRES_DB=teampulse
POSTGRES_USER=teampulse
POSTGRES_PASSWORD=teampulse
# Puerto publicado en el host; la app usa postgres:5432 dentro de Docker.
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
# Si reutilizás datos, la versión mayor debe coincidir con PG_VERSION del volumen.
POSTGRES_IMAGE=postgres:17-bookworm
